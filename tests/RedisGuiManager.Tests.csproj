<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinForms designer-free unit tests: no ApplicationConfigurationGenerator, no UI thread. -->
    <IsPackable>false</IsPackable>
    <UseWindowsForms>true</UseWindowsForms>
    <OutputType>Library</OutputType>
    <!-- The main app is a WinExe; referencing it from a test library needs the exe output. -->
    <GenerateProgramFile>true</GenerateProgramFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RedisGuiManager\RedisGuiManager.csproj" />
  </ItemGroup>

</Project>